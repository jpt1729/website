---
import Layout from "../layouts/Layout.astro";
import ToolTip from "../components/Tooltip";
import SocialRow from "../components/SocialRow.astro";
import DropDown from "../components/DropDown";
---

<Layout title="John Tan-Aristy">
  <main class="max-w-(--breakpoint-xl) m-auto px-4 py-6 text-base">
    <h1
      class="text-5xl lg:text-9xl text-light-accent border-b-8 border-light-accent w-fit mb-8"
    >
      {"> ABOUT"}
    </h1>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-12 gap-y-8 items-start">
      <!-- Left col: Bio + Social -->
      <div class="flex flex-col gap-6">
        <div>
          <h2 class="font-bold text-2xl mb-2">A little bit about me</h2>
          <p>
            Hi y'all. I'm John. I'm a second year ECE student at UT Austin from
            Houston, Texas. I love hackathons, working on hardware projects, and
            web development. Currently interning at the U.S. Bureau of
            Reclamation as a software engineering intern building internal web
            apps.
            <br />
            <br />
            In my free time, I like to explore cities, train Jiu Jitsu, and of course Texas football.
            <br />
            <br />
            Right now, I'm designing a "hackathon" ESP32 devboard with native
            LiPo battery support, and <ToolTip tooltip={"just spamming hdlbits 💔"} client:load><span>learning Verilog</span></ToolTip>.
          </p>
        </div>

        <SocialRow />
      </div>

      <!-- Right col: Experiences + Tools -->
      <div class="flex flex-col gap-10">
        <div>
          <h2 class="font-bold text-2xl mb-2">Some of my experiences</h2>
          <div>
          <DropDown title="Engineering Intern - Bureau of Reclamation" client:load>
            <p>
              Working with the Enterprise Information Management Group on the
              bureau's asset management systems — optimizing SQL Server
              schemas, building data dashboards for Western US regional
              offices, and independently developing the Land Use Authorization
              System, a Next.js and FastAPI app that automates SF-299 form
              tracking and multi-stage approval workflows.
            </p>
          </DropDown>
          <DropDown title="Tech Lead - Longhorn Studies" client:load>
            <p>
              Leading a team of 4 engineers building Longhorn Studies (<a
                href="https://github.com/Longhorn-Developers/Longhorn-Studies"
                >github.com/Longhorn-Developers/Longhorn-Studies</a
              >), a study recommendation app for UT Austin's 50,000+ students,
              within Longhorn Developers — a student-run open source dev org at
              UT Austin (Hook 'em Horns 🤘). Writing specs, running parallel
              development across React Native, Flask, and Supabase, and still
              building core screens from Figma alongside our design team.
            </p>
            <div class="flex gap-2 mt-1">
              <img
                src="/images/studies-home.png"
                alt="Longhorn Studies home screen"
                class="w-1/4 shadow-xs"
              />
              <img
                src="/images/studies-filter.png"
                alt="Longhorn Studies filter screen"
                class="w-1/4 shadow-xs"
              />
            </div>
            <p class="text-xs opacity-50 mt-1">
              Beautiful designs built by the Longhorn Studies design team.
            </p>
            <br />
          </DropDown>
          <DropDown title="Hackathons" client:load>
            <p>
              Competed in hackathons across the country, most recently YHack at
              Yale and HackClub's Undercity at GitHub HQ. Each one's a
              different problem, a different team, and a different excuse to
              build something fast and figure out the details later.
            </p>
          </DropDown>
        </div>
          <ToolTip tooltip={"Redirect to my works page."} client:load>
            <a
              href="/work"
              class="inline-block mt-4 px-5 text-sm opacity-50 hover:opacity-100 hover:underline decoration-light-accent decoration-2 transition-opacity"
            >
              {"> see all my work"}
            </a>
          </ToolTip>
        </div>

        <div>
          <h2 class="font-bold text-2xl mb-2">My tools</h2>
          <div class="flex gap-12">
            <div class="w-fit">
              <h3 class="text-[#00208F] underline">Frameworks</h3>
              <ul>
                <ToolTip tooltip={"My go to framework!"} client:load>
                  <li class="w-fit">{"> React.js"}</li>
                </ToolTip>
                <li class="w-fit">{"> React Native"}</li>
                <li class="w-fit">{"> Expo"}</li>
                <ToolTip tooltip={"All the animations on this site!"} client:load>
                  <li class="w-fit">{"> Framer Motion"}</li>
                </ToolTip>
                <li class="w-fit">{"> Next.js"}</li>
                <ToolTip tooltip={"What this website is made in!"} client:load>
                  <li class="w-fit">{"> Astro"}</li>
                </ToolTip>
                <li class="w-fit">{"> Pandas"}</li>
                <li class="w-fit">{"> Numpy"}</li>
                <li class="w-fit">{"> Tensorflow"}</li>
                <li class="w-fit">{"> Matplotlib"}</li>
                <ToolTip tooltip={"My graphs!"} client:load>
                  <li class="w-fit">{"> Seaborn"}</li>
                </ToolTip>
              </ul>
            </div>
            <div class="flex flex-col gap-6">
              <div class="w-fit">
                <h3 class="text-light-accent underline">Languages</h3>
                <ul>
                  <li class="w-fit">{"> JavaScript"}</li>
                  <li class="w-fit">{"> Python"}</li>
                  <li class="w-fit">{"> C/C++"}</li>
                  <li class="w-fit">{"> ARM Assembly"}</li>
                  <li class="w-fit">{"> HTML/CSS"}</li>
                </ul>
              </div>
              <div class="w-fit">
                <h3 class="text-[#C6A862] underline">Tools</h3>
                <ul>
                  <ToolTip tooltip={"I <3 Figma"} client:load>
                    <li class="w-fit">{"> Figma"}</li>
                  </ToolTip>
                  <li class="w-fit">{"> KiCad"}</li>
                  <ToolTip tooltip={"Tragically :("} client:load>
                    <li class="w-fit">{"> LTSpice"}</li>
                  </ToolTip>
                  <ToolTip tooltip={"Literally what I am using rn"} client:load>
                    <li class="w-fit">{"> VSCode"}</li>
                  </ToolTip>
                  <li class="w-fit">{"> Git"}</li>
                  <li class="w-fit">{"> GitHub Actions"}</li>
                  <li class="w-fit">{"> Azure DevOps"}</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
