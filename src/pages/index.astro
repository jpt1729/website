---
import Layout from "../layouts/Layout.astro";

import Hero from "../components/Card/index.astro";

import ToolTip from "../components/Tooltip";
---

<Layout title="John Tan-Aristy">
  <main
    class="flex max-w-screen-lg m-auto items-center gap-24 md:p-6 p-3 md:flex-row flex-col"
  >
    <div>
      <h1 class="md:text-8xl text-6xl font-normal leading-snug">
        IMAGINE,<br />
        DESIGN,<br />
        BUILD.<br />
      </h1>
      <ToolTip tooltip={"Redirect to my about page."} client:load>
        <a
          href="/about"
          class="inline-block mt-4 md:text-xl text-lg hover:underline decoration-light-accent decoration-2 transition-opacity"
        >
          {"> about me"}
        </a>
      </ToolTip>
    </div>
    <Hero />
  </main>
</Layout>
