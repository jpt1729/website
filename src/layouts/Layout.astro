---
import "@fontsource/ibm-plex-mono";
import "../styles/global.css";
import { execSync } from "node:child_process";

import Navbar from "../components/Navbar";
interface Props {
  title: string;
}

const { title } = Astro.props;

let gitHash = "dev";
if (import.meta.env.PROD) {
  // Vercel builds don't ship git history, but expose the deployed commit.
  const vercelSha = process.env.VERCEL_GIT_COMMIT_SHA;
  if (vercelSha) {
    gitHash = vercelSha.slice(0, 7);
  } else {
    try {
      gitHash = execSync("git rev-parse --short HEAD").toString().trim();
    } catch {
      gitHash = "unknown";
    }
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="John Tan-Aristy's website" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-off-white">
    <Navbar client:load pathname={Astro.url.pathname.replace(/\/$/, '') || '/'} gitHash={gitHash} />
    <div class="w-full h-14"></div>
    <slot />
    <div class="w-full h-14 md:hidden"></div>
  </body>
</html>
<style is:global>
  html {
    font-family: system-ui, sans-serif;
  }
  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }
  @font-face {
    font-family: 'GeistMono';
    src: url('/fonts/GeistMonoVF.woff') format('woff');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  body {
    font-family: "GeistMono", monospace;
  }
  ::selection {
    background-color: #1072fa;
    color: #ffffff;
  }

  .text-light-accent::selection,
  .text-light-accent *::selection {
    background-color: #0B1215;
    color: #ffffff;
  }

</style>
